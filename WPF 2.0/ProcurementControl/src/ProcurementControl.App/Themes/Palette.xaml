<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Цветовая палитра, перенесённая из app/modules/UiTheme.ps1 (Get-UiColor).
        Ключи соответствуют именам оригинальной палитры.
    -->

    <!-- Базовые поверхности -->
    <Color x:Key="CanvasColor">#F8FAFC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F1F5F9</Color>
    <Color x:Key="LineColor">#E2E8F0</Color>
    <Color x:Key="BorderColor">#CBD5E1</Color>
    <Color x:Key="HeaderColor">#F1F5F9</Color>

    <!-- Текст -->
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="MutedColor">#64748B</Color>

    <!-- Primary (акцент) -->
    <Color x:Key="PrimaryColor">#3159D8</Color>
    <Color x:Key="PrimaryHoverColor">#284BC0</Color>
    <Color x:Key="PrimaryPressColor">#203C9B</Color>
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>

    <!-- Secondary -->
    <Color x:Key="SecondaryColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#334155</Color>
    <Color x:Key="SecondaryBorderColor">#D7DFEB</Color>

    <!-- Навигация -->
    <Color x:Key="NavColor">#0F172A</Color>
    <Color x:Key="NavActiveColor">#1E293B</Color>
    <Color x:Key="NavHoverColor">#1E293B</Color>
    <Color x:Key="NavTextColor">#E2E8F0</Color>
    <Color x:Key="NavMutedColor">#94A3B8</Color>
    <Color x:Key="NavDividerColor">#334155</Color>
    <Color x:Key="NavAccentColor">#3159D8</Color>

    <!-- Состояния -->
    <Color x:Key="InfoColor">#DBEAFE</Color>
    <Color x:Key="SuccessColor">#DCFCE7</Color>
    <Color x:Key="SuccessTextColor">#166534</Color>
    <Color x:Key="WarnColor">#FEF9C3</Color>
    <Color x:Key="WarnTextColor">#854D0E</Color>
    <Color x:Key="DangerColor">#FEE2E2</Color>
    <Color x:Key="DangerTextColor">#991B1B</Color>
    <Color x:Key="AttentionColor">#F3E8FF</Color>
    <Color x:Key="AttentionTextColor">#7E22CE</Color>

    <!-- Приоритеты сделок (перенос Apply-PriorityCellStyle) -->
    <Color x:Key="PriorityUrgentColor">#EB464B</Color>
    <Color x:Key="Priority1Color">#FFB0B0</Color>
    <Color x:Key="Priority2Color">#FFDAB3</Color>
    <Color x:Key="Priority3Color">#FFF5D7</Color>
    <Color x:Key="Priority4Color">#DDEBFF</Color>
    <Color x:Key="Priority5Color">#E2EEE2</Color>

    <!-- Дизайн-система: состояния полей ввода, тени, тёмная навигация -->
    <Color x:Key="InputHoverBorderColor">#94A3B8</Color>
    <Color x:Key="RowHoverColor">#F8FAFC</Color>
    <Color x:Key="NavSelectedTextColor">#FFFFFF</Color>
    <Color x:Key="ShadowColor">#0F172A</Color>

    <!-- Акценты быстрого захвата (цвета диалога оригинального агента) -->
    <Color x:Key="AmberColor">#D97706</Color>
    <Color x:Key="AmberHoverColor">#B45309</Color>
    <Color x:Key="AmberLightColor">#FFF7ED</Color>
    <Color x:Key="PrimaryLightColor">#EEF3FF</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressBrush" Color="{StaticResource PrimaryPressColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource SecondaryBorderColor}"/>

    <SolidColorBrush x:Key="NavBrush" Color="{StaticResource NavColor}"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="{StaticResource NavActiveColor}"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="{StaticResource NavHoverColor}"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="{StaticResource NavTextColor}"/>
    <SolidColorBrush x:Key="NavMutedBrush" Color="{StaticResource NavMutedColor}"/>
    <SolidColorBrush x:Key="NavDividerBrush" Color="{StaticResource NavDividerColor}"/>
    <SolidColorBrush x:Key="NavAccentBrush" Color="{StaticResource NavAccentColor}"/>

    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="{StaticResource WarnTextColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}"/>
    <SolidColorBrush x:Key="AttentionBrush" Color="{StaticResource AttentionColor}"/>
    <SolidColorBrush x:Key="AttentionTextBrush" Color="{StaticResource AttentionTextColor}"/>

    <SolidColorBrush x:Key="PriorityUrgentBrush" Color="{StaticResource PriorityUrgentColor}"/>
    <SolidColorBrush x:Key="Priority1Brush" Color="{StaticResource Priority1Color}"/>
    <SolidColorBrush x:Key="Priority2Brush" Color="{StaticResource Priority2Color}"/>
    <SolidColorBrush x:Key="Priority3Brush" Color="{StaticResource Priority3Color}"/>
    <SolidColorBrush x:Key="Priority4Brush" Color="{StaticResource Priority4Color}"/>
    <SolidColorBrush x:Key="Priority5Brush" Color="{StaticResource Priority5Color}"/>

    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{StaticResource InputHoverBorderColor}"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}"/>
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="{StaticResource NavSelectedTextColor}"/>

    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="AmberHoverBrush" Color="{StaticResource AmberHoverColor}"/>
    <SolidColorBrush x:Key="AmberLightBrush" Color="{StaticResource AmberLightColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>

    <!-- Границы карточек: внешняя мягкая и внутренняя основная -->
    <Color x:Key="CardOuterBorderColor">#EEF2F7</Color>
    <SolidColorBrush x:Key="CardOuterBorderBrush" Color="{StaticResource CardOuterBorderColor}"/>

</ResourceDictionary>
