<Window x:Class="ProcurementControl.Views.MailImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        MaxHeight="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True"
        FontFamily="Segoe UI" FontSize="12">

    <!-- Постоянное уведомление о пришедших RRFQ: закрывается только ОК или крестиком -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            MouseLeftButtonDown="BorderDragMove">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка: иконка почты, заголовок, крестик -->
            <Grid Grid.Row="0">
                <Border Width="54" Height="54"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="20,18,0,0"
                        Background="#EFF6FF" CornerRadius="10">
                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                               FontSize="26"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Пришли RRFQ файлы"
                           Margin="92,21,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           FontFamily="Segoe UI Semibold" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <Button Content="×"
                        Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,15,18,0"
                        FontSize="14" Foreground="{StaticResource MutedBrush}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseClicked"/>
                <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource LineBrush}"
                           VerticalAlignment="Bottom" Margin="20,0,20,0"/>
            </Grid>

            <!-- Список загруженных файлов -->
            <ScrollViewer Grid.Row="1" Margin="20,12,20,0"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LinesText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12" LineHeight="19"/>
            </ScrollViewer>

            <!-- Кнопка ОК -->
            <Button Grid.Row="2" Content="ОК"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="32" Margin="16,14,16,16"
                    Click="OkClicked"/>
        </Grid>
    </Border>
</Window>
