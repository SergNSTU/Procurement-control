<UserControl x:Class="ProcurementControl.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcurementControl.Views"
             Background="{StaticResource CanvasBrush}">

    <!-- Две карточки: настройки закупки и корзина/копии (аналог $settingsLayout, строки 3428-3552) -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Настройки контроля закупки -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Настройки контроля закупки" Margin="0,0,0,12"/>

                <!-- Папка документов: редактируемое поле + кнопка выбора ($btnChooseDocumentsRoot) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Папка документов"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DocumentsRoot, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="Выбрать..."
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ChooseDocumentsRootCommand}"
                            Height="30" Width="90" Margin="8,0,0,0"/>
                </Grid>

                <!-- Быстрый захват: редактируемый чекбокс -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Быстрый захват"/>
                    <CheckBox Grid.Column="1"
                              Content="Разрешить создание из браузера и чатов"
                              IsChecked="{Binding QuickCaptureEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding QuickCaptureHint}"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="150,6,0,0"/>

                <!-- Аналог $btnSaveSettings -->
                <Button Content="Сохранить настройки"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"
                        Height="32" Width="170" HorizontalAlignment="Left"
                        Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- Корзина и резервные копии (карточка растягивается на остаток страницы) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Корзина и резервные копии" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="Создать копию"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateBackupCommand}"
                            Height="30" Width="125" Margin="0,0,8,0"/>
                    <Button Content="Восстановить выбранное"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RestoreSelectedCommand}"
                            Height="30" Width="185" Margin="0,0,8,0"/>
                    <Button Content="Удалить безвозвратно"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteSelectedCommand}"
                            Height="30" Width="165" Margin="0,0,8,0"/>
                    <Button Content="Папка копий"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenFolderCommand}"
                            Height="30" Width="125"/>
                </StackPanel>

                <Border Grid.Row="2" CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10" Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding RecoveryRows}"
                              SelectedItem="{Binding SelectedRecoveryRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              BorderThickness="1"
                              BorderBrush="{StaticResource LineBrush}"
                              RowHeight="28"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип" Binding="{Binding KindText}" Width="135"/>
                            <DataGridTextColumn Header="Создано" Binding="{Binding CreatedText}" Width="145"/>
                            <DataGridTextColumn Header="Что сохранено" Binding="{Binding Reason}" Width="*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{Binding RecoveryHint}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerTextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
