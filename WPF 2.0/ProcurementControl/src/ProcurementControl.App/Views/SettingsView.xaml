<UserControl x:Class="ProcurementControl.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- Сетка — как в остальных разделах (аналог Set-GridLook) -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Поле папки документов (только чтение) -->
        <Style x:Key="SettingsBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Раскладка оригинала: $settingsLayout, колонки 180/*/150 (строки 3428-3552) -->
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Настройки контроля закупки"
                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   VerticalAlignment="Center"/>

        <!-- Папка документов: отображение без кнопки выбора -->
        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}"
                   Text="Папка документов"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                 Style="{StaticResource SettingsBox}"
                 IsReadOnly="True"
                 Text="{Binding DocumentsRoot, Mode=OneWay}"/>

        <!-- Быстрый захват: значение из базы, чекбокс заблокирован -->
        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingsLabel}"
                   Text="Быстрый захват"/>
        <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                  Content="Разрешить создание из браузера и чатов"
                  IsChecked="{Binding QuickCaptureEnabled, Mode=OneWay}"
                  IsEnabled="False"
                  FontFamily="Segoe UI" FontSize="12"
                  VerticalAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                   Text="{Binding QuickCaptureHint}"
                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                   VerticalAlignment="Center"/>

        <!-- Вместо «Сохранить настройки» — напоминание о режиме чтения -->
        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                   Text="{Binding ReadOnlyNotice}"
                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                   VerticalAlignment="Center"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Корзина и резервные копии"
                   FontFamily="Segoe UI Semibold" FontSize="10"
                   Foreground="{StaticResource TextBrush}"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal">
            <Button Content="Папка копий"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenFolderCommand}"
                    Height="30" Width="125"/>
        </StackPanel>

        <DataGrid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                  ItemsSource="{Binding RecoveryRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource LineBrush}"
                  Foreground="{StaticResource TextBrush}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}"
                  ColumnHeaderHeight="32"
                  RowHeight="28"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" Binding="{Binding KindText}" Width="135"/>
                <DataGridTextColumn Header="Создано" Binding="{Binding CreatedText}" Width="145"/>
                <DataGridTextColumn Header="Что сохранено" Binding="{Binding Reason}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal">
            <TextBlock Text="{Binding RecoveryHint}"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerTextBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
