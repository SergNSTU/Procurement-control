<Window x:Class="ProcurementControl.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Быстрый захват"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <!-- Кнопка сохранения для режима напоминания: янтарный акцент оригинала -->
        <Style x:Key="AmberButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AmberHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Порт Show-QuickCaptureDialog (QuickCaptureAgent.ps1, строки 335-446):
        тот же состав полей, но в стиле дизайн-системы приложения.
    -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Акцентная полоса слева: синий для задач, янтарный для напоминаний -->
            <Border Grid.Column="0" x:Name="AccentBar"
                    Background="{StaticResource PrimaryHoverBrush}"
                    CornerRadius="14,0,0,14"/>

            <Grid Grid.Column="1" Margin="22,20,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Шапка: иконка, заголовок, подпись, крестик -->
                <Grid Grid.Row="0">
                    <Border x:Name="IconBox" Width="48" Height="48"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource PrimaryLightBrush}"
                            CornerRadius="10">
                        <TextBlock x:Name="IconGlyph" Text="&#xE9D5;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource PrimaryHoverBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="62,2,40,0">
                        <TextBlock x:Name="HeadingText" Text="Новая задача"
                                   FontFamily="Segoe UI Semibold" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Быстрый захват из выделенного текста"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="×"
                            Width="30" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            FontSize="15" Foreground="{StaticResource MutedBrush}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelClicked"/>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"
                               VerticalAlignment="Bottom" Margin="0,16,0,0"/>
                </Grid>

                <!-- Заголовок записи -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Что нужно сделать" Margin="0,0,0,6"/>
                    <TextBox x:Name="TitleBox" FontSize="13"/>
                </StackPanel>

                <!-- Сделка (только для задач) -->
                <StackPanel Grid.Row="2" x:Name="DealBlock" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Сделка" Margin="0,0,0,6"/>
                    <TextBox x:Name="DealBox"/>
                </StackPanel>

                <!-- Дата и время -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DateCaption" Style="{StaticResource FieldLabel}"
                                   Text="Срок задачи" Margin="0,0,0,6"/>
                        <DatePicker x:Name="DueDatePicker" Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Время" Margin="0,0,0,6"/>
                        <TextBox x:Name="DueTimeBox" Height="30"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Grid.Column="4" x:Name="HasDueCheck"
                              Content="Указать срок"
                              VerticalAlignment="Bottom" Margin="0,0,0,5"
                              Checked="HasDueChanged" Unchecked="HasDueChanged"/>
                    <TextBlock Grid.Column="4" x:Name="DateHint"
                               Text="Уведомление появится в указанное время"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,7"
                               TextWrapping="Wrap"/>
                </Grid>

                <!-- Подвал: подсказка об исходном тексте и кнопки -->
                <Grid Grid.Row="4" Margin="0,18,0,0">
                    <TextBlock Text="Исходный текст сохранится полностью"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="90" Height="32" Margin="0,0,8,0"
                                Click="CancelClicked"/>
                        <Button x:Name="SaveButton" Content="Создать задачу"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="150" Height="32"
                                Click="SaveClicked"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
