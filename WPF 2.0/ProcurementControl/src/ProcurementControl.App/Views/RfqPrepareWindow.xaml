<Window x:Class="ProcurementControl.Views.RfqPrepareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подготовка RFQ для поставщиков" Width="1200" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="HintText" Margin="0,6,0,0"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                       Text="Галочка «В RFQ» предзаполнена по зелёной заливке исходника (если она распознана). Поставщикам уходит только отмеченное; остальные строки попадут в список «Для Компэла». Тексты можно править прямо в таблице."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,10,0,8">
            <Button Content="Отметить все" Style="{StaticResource SecondaryButtonStyle}"
                    Height="28" Width="110" Margin="0,0,8,0" Click="IncludeAllClick"/>
            <Button Content="Снять все" Style="{StaticResource SecondaryButtonStyle}"
                    Height="28" Width="100" Margin="0,0,8,0" Click="IncludeNoneClick"/>
            <Button Content="Только зелёные" Style="{StaticResource SecondaryButtonStyle}"
                    Height="28" Width="120" Margin="0,0,16,0" Click="IncludeGreenOnlyClick"
                    ToolTip="Отметить только строки с распознанной зелёной заливкой"/>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid x:Name="RowsGrid"
                      ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="В RFQ" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="Стр." Binding="{Binding SourceRow}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="230"/>
                    <DataGridTextColumn Header="Russian remark" Binding="{Binding RussianRemark}" Width="200"/>
                    <DataGridTextColumn Header="China remark" Binding="{Binding ChinaRemark}" Width="200"/>
                    <DataGridTextColumn Header="PN" Binding="{Binding PN}" Width="120"/>
                    <DataGridTextColumn Header="D/C" Binding="{Binding DC}" Width="50"/>
                    <DataGridTextColumn Header="Mfg Russia" Binding="{Binding MfgRussia}" Width="120"/>
                    <DataGridTextColumn Header="Mfg China" Binding="{Binding MfgChina}" Width="120"/>
                    <DataGridTextColumn Header="Упак." Binding="{Binding QtyPacking}" Width="70"/>
                    <DataGridTextColumn Header="Купить, шт" Binding="{Binding QtyToBuy}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BuildButton" Content="Собрать и перейти к рассылке"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="32" Width="220" Margin="0,0,8,0" Click="BuildClick"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}"
                    Height="32" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
