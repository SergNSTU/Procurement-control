<Window x:Class="ProcurementControl.Views.TileDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="560" Height="420" MinWidth="420" MinHeight="240"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Foreground="{StaticResource TextBrush}"
                   FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Foreground="{StaticResource MutedBrush}"
                   FontFamily="Segoe UI" FontSize="11"
                   Text="Двойной щелчок по строке — перейти к сделке."
                   Margin="0,0,0,8"/>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Border CornerRadius="10" Background="Transparent"
                    xmlns:local="clr-namespace:ProcurementControl.Views"
                    local:RoundedClip.Radius="10">
                <ListBox x:Name="LinesList"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Segoe UI" FontSize="12"
                         Foreground="{StaticResource TextBrush}"
                         DisplayMemberPath="Text"
                         MouseDoubleClick="LinesList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="90" Height="30"
                    Click="CloseClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
