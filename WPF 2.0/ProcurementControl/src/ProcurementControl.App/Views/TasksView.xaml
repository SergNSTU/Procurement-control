<UserControl x:Class="ProcurementControl.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcurementControl.Views"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- Точные цвета строк задач из Apply-ComponentRowStyle исходного приложения. -->
        <Style x:Key="TaskRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource AppGridRowStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="В работе"><Setter Property="Background" Value="#FFE2E2"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Ожидание ответа"><Setter Property="Background" Value="#FFF5D7"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="На отслеживании"><Setter Property="Background" Value="#DDEBFF"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Заказано"><Setter Property="Background" Value="#DDF6E4"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Подано в оплату"><Setter Property="Background" Value="#D6E8FF"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Выполнено"><Setter Property="Background" Value="#C6EFCE"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Тулбар: поиск, действия с задачами, обновление -->
        <WrapPanel Grid.Row="0" Style="{StaticResource ToolbarWrapStyle}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Поиск сделки:" Margin="0,0,8,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
            <Button Content="Новая задача"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding NewTaskCommand}"
                    Height="30" Margin="12,0,4,0"/>
            <Button Content="Сохранить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveTaskCommand}"
                    Height="30" Margin="0,0,4,0"/>
            <Button Content="Завершить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CompleteTaskCommand}"
                    Height="30" Margin="0,0,4,0"/>
            <Button Content="Удалить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding DeleteTaskCommand}"
                    Height="30" Margin="0,0,4,0"/>
            <Button Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}"
                    Height="30"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource ToolbarStatusTextStyle}" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ToolbarErrorTextStyle}" Margin="16,0,0,0"/>
        </WrapPanel>

        <!-- Сетка задач в карточке (аналог $componentsGrid) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,14,0,0">
            <Border CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                <DataGrid x:Name="TasksGrid" ItemsSource="{Binding Tasks}"
                          SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowStyle="{StaticResource TaskRowStyle}"
                          BorderThickness="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Loaded="TasksGrid_Loaded"
                          MouseDoubleClick="TasksGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="TasksGrid_PreviewMouseRightButtonDown"
                          CellEditEnding="TasksGrid_CellEditEnding">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Скопировать номер сделки" Command="{Binding CopyDealNumberCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата входа" Binding="{Binding EntryDate}" Width="96" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Сделка" Binding="{Binding DealNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="DealNumber" Width="170"/>
                        <DataGridTemplateColumn Header="Статус" Width="145" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Padding="8,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.TaskStatuses, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Этап" Width="170" SortMemberPath="Stage">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Stage}" Padding="8,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.TaskStages, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Description" Width="260"/>
                        <DataGridTextColumn Header="След.действие" Binding="{Binding NextAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="NextAction" Width="230"/>
                        <DataGridTemplateColumn Header="Напоминание" SortMemberPath="ReminderDate" Width="112" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReminderDate}" Padding="8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReminderOverdue}" Value="True">
                                                        <Setter Property="Background" Value="#FF0000"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Дедлайн" Binding="{Binding DeadlineDate}" SortMemberPath="DeadlineDate" Width="112" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Приоритет" Width="92" SortMemberPath="Priority">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Priority}" Padding="8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Срочно"><Setter Property="Background" Value="#EB464B"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="1"><Setter Property="Background" Value="#FFB0B0"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="2"><Setter Property="Background" Value="#BAD5FF"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="3"><Setter Property="Background" Value="#CFE2FF"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="4"><Setter Property="Background" Value="#E0E4EB"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="5"><Setter Property="Background" Value="#EBEEF3"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate><ComboBox ItemsSource="{Binding DataContext.TaskPriorities, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Период" Width="110" SortMemberPath="Period">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Period}" Padding="8,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.TaskPeriods, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Period, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Сумма заказа, $" Binding="{Binding OrderAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="OrderAmount" Width="118"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      Background="Transparent"/>

        <!-- Записи выбранной задачи -->
        <Border Grid.Row="3" Grid.RowSpan="2" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="Записи по сделке"/>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBox Grid.Row="1"
                         Text="{Binding EditableNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontSize="13"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
