<UserControl x:Class="ProcurementControl.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Тулбар: поиск по сделке, обновление, пометка о режиме чтения -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Поиск по сделке:"
                       Foreground="{StaticResource TextBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0" Width="112"
                       TextAlignment="Left"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="220" Height="30"
                     FontFamily="Segoe UI" FontSize="12"
                     VerticalContentAlignment="Center"
                     Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource LineBrush}"
                     Foreground="{StaticResource TextBrush}"/>
            <Button Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}"
                    Height="30" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding ReadOnlyNotice}"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerTextBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- Подсказка оригинала (строка 2506) -->
        <TextBlock Grid.Row="1" Margin="0,8,0,0"
                   Text="Автоматические пункты строятся из статусов закупки; ручные можно закрывать кнопкой &quot;Готово&quot;. Для &quot;скоро поступление&quot; и &quot;поступление просрочено&quot; используйте &quot;Поступило&quot;."
                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                   TextWrapping="Wrap"/>

        <!-- Счётчики по важности -->
        <TextBlock Grid.Row="2" Text="{Binding CountText}"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   Margin="0,8,0,0"/>

        <!-- Сетка напоминаний (аналог $remindersGrid) -->
        <DataGrid Grid.Row="3"
                  Margin="0,12,0,0"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="{StaticResource SurfaceBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource LineBrush}"
                  FontFamily="Segoe UI" FontSize="12"
                  Foreground="{StaticResource TextBrush}"
                  ColumnHeaderHeight="36"
                  RowHeight="30"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <!-- Фон строки по важности: строки 4315-4321 оригинала -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Danger">
                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Attention">
                            <Setter Property="Background" Value="{StaticResource AttentionBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Warn">
                            <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Важность" Binding="{Binding Severity}" Width="90"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DueDate}" Width="95"/>
                <DataGridTextColumn Header="Что сделать" Binding="{Binding Title}" Width="560"/>
                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
