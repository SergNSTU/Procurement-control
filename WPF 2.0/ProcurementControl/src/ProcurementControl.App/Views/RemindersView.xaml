<UserControl x:Class="ProcurementControl.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcurementControl.Views"
             Background="{StaticResource CanvasBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Тулбар: поиск по сделке, действия, обновление ($remindersToolbar оригинала) -->
        <WrapPanel Grid.Row="0" Style="{StaticResource ToolbarWrapStyle}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Поиск по сделке:" Margin="0,0,8,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
            <Button Content="Новое напоминание"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding NewReminderCommand}"
                    Height="30" Margin="12,0,0,0"/>
            <Button Content="Готово"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding DoneReminderCommand}"
                    Height="30" Width="90" Margin="8,0,0,0"/>
            <Button Content="Удалить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding DeleteReminderCommand}"
                    Height="30" Width="90" Margin="8,0,0,0"/>
            <Button Content="Поступило"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReceiptArrivedCommand}"
                    Height="30" Width="100" Margin="8,0,0,0"/>
            <Button Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}"
                    Height="30" Margin="12,0,0,0"/>
            <!-- $chkNotificationsEnabled (строки 2484-2490 оригинала) -->
            <CheckBox Content="Уведомления включены"
                      IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0"/>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ToolbarErrorTextStyle}" Margin="16,0,0,0"/>
        </WrapPanel>

        <!-- Подсказка оригинала (строка 2506) -->
        <TextBlock Grid.Row="1" Margin="0,10,0,0"
                   Text="Любое выбранное напоминание можно удалить через контекстное меню; ручные также можно закрывать кнопкой &quot;Готово&quot;. Для &quot;скоро поступление&quot; и &quot;поступление просрочено&quot; используйте &quot;Поступило&quot;."
                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                   TextWrapping="Wrap"/>

        <!-- Счётчики по важности -->
        <TextBlock Grid.Row="2" Text="{Binding CountText}"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   Margin="0,6,0,0"/>

        <!-- Сетка напоминаний в карточке (аналог $remindersGrid) -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0,12,0,0">
            <Border CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <!-- Контекстное меню оригинала: $remindersDeleteMenuItem -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Удалить напоминание" Command="{Binding DeleteReminderCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <!-- Фон строки по важности: строки 4315-4321 оригинала -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Attention">
                                    <Setter Property="Background" Value="{StaticResource AttentionBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warn">
                                    <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <!-- Прозрачные ячейки, чтобы был виден фон строки по важности -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource AppGridCellStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Важность" Binding="{Binding Severity}" Width="90"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DueDate}" Width="95"/>
                        <DataGridTextColumn Header="Что сделать" Binding="{Binding Title}" Width="560"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </Grid>
</UserControl>
