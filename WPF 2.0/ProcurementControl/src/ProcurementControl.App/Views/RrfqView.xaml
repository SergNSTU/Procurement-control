<UserControl x:Class="ProcurementControl.Views.RrfqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- Карточка раздела (аналог New-CardPanel) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Заголовок карточки (аналог *GroupTitle) -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Общий стиль сеток (аналог Set-GridLook) -->
        <Style x:Key="GridLook" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>

        <Style x:Key="GridHeaderLook" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Перенос текста в длинных колонках (оригинал подгонял высоту строк) -->
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="248"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя полоса: выбор файлов 68% / параметры 32% (строки 989-996) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="32*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Выбор файла (строки 998-1086) -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="1. Выбор файла"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="142"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RFQ" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBox Grid.Column="1" Margin="0,0,8,0"
                                     Text="{Binding RfqPath, Mode=OneWay}"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource SurfaceBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource SecondaryBorderBrush}"
                                     Padding="6,0" FontFamily="Segoe UI" FontSize="12"/>
                            <Button Grid.Column="2" Content="Выбрать..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ChooseRfqCommand}"/>
                        </Grid>

                        <!-- Файлы поставщиков; имя поставщика можно вписать -->
                        <DataGrid x:Name="supplierGrid" Grid.Row="1"
                                  Style="{StaticResource GridLook}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderLook}"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectionMode="Extended"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Файл поставщика"
                                                    Binding="{Binding Path}"
                                                    Width="72*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Поставщик (можно вписать)"
                                                    Binding="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="28*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Добавить поставщиков" Width="180" Height="28" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddSuppliersCommand}"/>
                            <Button Content="Удалить выбранные" Width="160" Height="28" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RemoveSelectedSuppliersClick"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 2. Параметры и запуск (строки 1088-1167) -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="2. Параметры и запуск"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Приоритет победителя -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="Приоритет:" FontWeight="Bold" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton Content="Цена" GroupName="Priority" Margin="0,0,12,0"
                                             IsChecked="{Binding IsPricePriority, Mode=TwoWay}"
                                             Foreground="{StaticResource TextBrush}"/>
                                <RadioButton Content="Срок" GroupName="Priority"
                                             IsChecked="{Binding IsLeadTimePriority, Mode=TwoWay}"
                                             Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="1" Content="Сформировать preview" Margin="0,2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RunPreviewCommand}"/>
                        <Button Grid.Row="2" Content="Ручное сопоставление" Margin="0,2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenManualMatchCommand}"/>
                        <Button Grid.Row="3" Content="Создать результирующий RRFQ" Margin="0,2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveResultCommand}"/>

                        <!-- Лог (аналог $logBox) -->
                        <TextBox Grid.Row="4" Margin="0,4,0,0"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource SurfaceAltBrush}"
                                Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource LineBrush}"
                                 FontFamily="Segoe UI" FontSize="12"
                                 Padding="6"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 3. Preview и ручная корректировка (строки 1169-1380) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                           Text="3. Preview и ручная корректировка"/>

                <!-- Панель фильтра (строки 1190-1238) -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Фильтр:" Width="56" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <ComboBox Width="190" Height="28" VerticalContentAlignment="Center"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"/>
                    <TextBlock Text="Поиск:" Width="52" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBox Width="240" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource SecondaryBorderBrush}"
                             Padding="6,0" FontFamily="Segoe UI" FontSize="12"/>
                    <Button Content="Включить" Width="92" Height="28" Margin="12,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding IncludeSelectedCommand}"/>
                    <Button Content="Исключить" Width="96" Height="28" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExcludeSelectedCommand}"/>
                </StackPanel>

                <!-- Preview сверху, квоты выбранной позиции снизу -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45*" MinHeight="140"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="55*" MinHeight="140"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="previewGrid" Grid.Row="0"
                              Style="{StaticResource GridLook}"
                              ColumnHeaderStyle="{StaticResource GridHeaderLook}"
                              ItemsSource="{Binding PreviewRows}"
                              SelectedItem="{Binding SelectedDecision, Mode=TwoWay}"
                              SelectionMode="Single"
                              IsReadOnly="False"
                              FrozenColumnCount="2">
                        <!-- Подсветка по статусу (аналог строк 32-43 в RrfqUi.ps1) -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="OK">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Нет квот">
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Нет сравнимой цены">
                                        <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Вкл" Width="44"
                                                    Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Статус" Width="115" IsReadOnly="True"
                                                Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="№" Width="54" IsReadOnly="True"
                                                Binding="{Binding Row}"/>
                            <DataGridTextColumn Header="Value" Width="230" IsReadOnly="True"
                                                Binding="{Binding Value}"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="PN" Width="170" IsReadOnly="True"
                                                Binding="{Binding WinnerPN}"/>
                            <DataGridTextColumn Header="Russian remark" Width="210" IsReadOnly="True"
                                                Binding="{Binding RussianRemark}"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="China remark" Width="210" IsReadOnly="True"
                                                Binding="{Binding ChinaRemark}"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="D/C" Width="90" IsReadOnly="True"
                                                Binding="{Binding DC}"/>
                            <DataGridTextColumn Header="MFG from Russia" Width="150" IsReadOnly="True"
                                                Binding="{Binding MfgRussia}"/>
                            <DataGridTextColumn Header="MFG from China" Width="150" IsReadOnly="True"
                                                Binding="{Binding MfgChina}"/>
                            <DataGridTextColumn Header="Q-ty in packing" Width="130" IsReadOnly="True"
                                                Binding="{Binding QtyPacking}"/>
                            <DataGridTextColumn Header="Q-ty to Buy/pcs" Width="130" IsReadOnly="True"
                                                Binding="{Binding QtyToBuy}"/>
                            <DataGridTextColumn Header="Победитель" Width="110" IsReadOnly="True"
                                                Binding="{Binding WinnerSupplier}"/>
                            <DataGridTextColumn Header="Почему выбран" Width="170" IsReadOnly="True"
                                                Binding="{Binding WinnerReason}"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Цена" Width="92" IsReadOnly="True"
                                                Binding="{Binding WinnerPriceText}"/>
                            <DataGridTextColumn Header="Срок" Width="105" IsReadOnly="True"
                                                Binding="{Binding WinnerLead}"/>
                            <DataGridTextColumn Header="Lead time total" Width="128" IsReadOnly="True"
                                                Binding="{Binding WinnerLeadTotal}"/>
                            <DataGridTextColumn Header="Все квоты" Width="330" IsReadOnly="True"
                                                Binding="{Binding QuotesSummary}"
                                                ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Предупреждения" Width="330" IsReadOnly="True"
                                                Binding="{Binding Warning}"
                                                ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{StaticResource LineBrush}"/>

                    <!-- Квоты выбранной позиции (строки 1310-1380) -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Квоты выбранной позиции" Width="188"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontWeight="Bold" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{StaticResource TextBrush}"/>
                            <Button Content="Сделать победителем" Width="160" Height="28" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SetWinnerCommand}"/>
                            <Button Content="Добавить квоту вручную" Width="180" Height="28"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddManualQuoteCommand}"/>
                        </StackPanel>

                        <DataGrid x:Name="quoteGrid" Grid.Row="1"
                                  Style="{StaticResource GridLook}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderLook}"
                                  ItemsSource="{Binding QuoteDetails}"
                                  SelectedItem="{Binding SelectedQuoteDetail, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  IsReadOnly="True"
                                  RowHeight="28"
                                  MouseDoubleClick="QuoteGridMouseDoubleClick">
                            <!-- Победитель подсвечен (аналог строк 198-200) -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Побед." Width="62" Binding="{Binding WinnerMark}"/>
                                <DataGridTextColumn Header="Поставщик" Width="100" Binding="{Binding Quote.Supplier}"/>
                                <DataGridTextColumn Header="Цена" Width="86" Binding="{Binding PriceText}"/>
                                <DataGridTextColumn Header="Срок" Width="96" Binding="{Binding Quote.LeadTime}"/>
                                <DataGridTextColumn Header="Total" Width="96" Binding="{Binding Quote.LeadTimeTotal}"/>
                                <DataGridTextColumn Header="PN" Width="150" Binding="{Binding Quote.PN}"/>
                                <DataGridTextColumn Header="MFG China" Width="120" Binding="{Binding Quote.MfgChina}"/>
                                <DataGridTextColumn Header="Pack" Width="80" Binding="{Binding Quote.QtyPacking}"/>
                                <DataGridTextColumn Header="Buy qty" Width="80" Binding="{Binding Quote.QtyToBuy}"/>
                                <DataGridTextColumn Header="Матчинг" Width="92" Binding="{Binding Quote.MatchStatus}"/>
                                <DataGridTextColumn Header="Предупреждение" Width="220" Binding="{Binding Quote.Warning}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
