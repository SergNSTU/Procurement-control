<Window x:Class="ProcurementControl.Views.NewReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новое напоминание" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Контекст привязки (виден, когда в списке выбран пункт со сделкой/поставщиком) -->
        <TextBlock x:Name="ContextText" Grid.Row="0"
                   Foreground="{StaticResource MutedBrush}"
                   FontFamily="Segoe UI" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Что нужно сделать?"
                   Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>

        <TextBox x:Name="TitleBox" Grid.Row="2" MinHeight="38"
                 FontFamily="Segoe UI" FontSize="12"
                 VerticalContentAlignment="Center"
                 Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource LineBrush}"
                 Foreground="{StaticResource TextBrush}"/>

        <TextBlock Grid.Row="3" Text="Когда напомнить (необязательно)"
                   Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>

        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" Content="Без даты"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="86" Height="30" Margin="8,0,0,0"
                    ToolTip="Оставить напоминание без даты"
                    Click="ClearDateClick"/>
            <DatePicker x:Name="DateBox" SelectedDateFormat="Short"
                        VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Создать"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="90" Height="30" Margin="0,0,8,0"
                    Click="AcceptClick" IsDefault="True"/>
            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="90" Height="30"
                    Click="CancelClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
