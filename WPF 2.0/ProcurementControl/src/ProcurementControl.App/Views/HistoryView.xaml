<UserControl x:Class="ProcurementControl.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcurementControl.Views"
             Background="{StaticResource CanvasBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Тулбар (аналог $historyToolbar) -->
        <WrapPanel Grid.Row="0" Style="{StaticResource ToolbarWrapStyle}">
            <Button Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    Width="100" Height="30" Margin="0,0,8,0"/>
            <Button Content="Текущая сделка"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding FilterBySelectedDealCommand}"
                    Width="130" Height="30" Margin="0,0,16,0"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Поиск:" Margin="0,0,8,0"/>
            <TextBox Width="220"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Очистить историю"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ClearHistoryCommand}"
                    Width="140" Height="30" Margin="16,0,16,0"/>
            <!-- Подсказка (аналог $historyHint) -->
            <TextBlock Text="{Binding Hint}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       MaxWidth="760"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </WrapPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding FilterNotice}"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Margin="0,8,0,0"/>

        <!-- Сетка журнала в карточке (аналог $historyGrid) -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,10,0,0">
            <Border CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="145"/>
                        <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="210"/>
                        <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="520"/>
                        <DataGridTextColumn Header="Объект" Binding="{Binding EntityType}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>

        <!-- Нижняя строка: статус и ошибки -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
