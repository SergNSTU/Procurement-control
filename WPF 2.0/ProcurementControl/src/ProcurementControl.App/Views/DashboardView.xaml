<UserControl x:Class="ProcurementControl.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- Плитка метрики (аналог New-CockpitMetricCard) -->
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="TileCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: месяц, дата старта отслеживания, обновление, ошибка -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding MonthLabel}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Margin="0,0,16,0">
                <Run Text="Отслеживание заказов с:"/>
                <Run Text="{Binding TrackingStartedText, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}"
                    Height="30"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerTextBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- Карточки метрик -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Сборки -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Сборки" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource InfoBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileCaption}" Text="Добавлено за месяц"/>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesAdded}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource InfoBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileCaption}" Text="Заказано за месяц"/>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesOrdered}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource SuccessBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileCaption}" Text="Конверсия (тек. когорта)"/>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesCurrentConversion}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource SuccessBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileCaption}" Text="Зрелая конверсия"/>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesMatureConversion}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Компоненты -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Компоненты" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource WarnBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileCaption}" Text="Добавлено за месяц"/>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsAdded}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource WarnBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileCaption}" Text="Заказано за месяц"/>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsOrdered}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource SuccessBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileCaption}" Text="Конверсия (тек. когорта)"/>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsCurrentConversion}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricTile}" Background="{StaticResource SuccessBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileCaption}" Text="Зрелая конверсия"/>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsMatureConversion}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- История за 6 месяцев -->
        <DataGrid Grid.Row="2"
                  Margin="0,14,0,0"
                  ItemsSource="{Binding History}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  Background="{StaticResource SurfaceBrush}"
                  RowBackground="{StaticResource SurfaceBrush}"
                  AlternatingRowBackground="{StaticResource SurfaceAltBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource LineBrush}"
                  FontFamily="Segoe UI" FontSize="12"
                  Foreground="{StaticResource TextBrush}"
                  ColumnHeaderHeight="36"
                  RowHeight="32">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Месяц" Binding="{Binding Label}" Width="90"/>
                <DataGridTextColumn Header="Сборки: добавлено" Binding="{Binding AssemblyAdded}" Width="*"/>
                <DataGridTextColumn Header="Сборки: заказано" Binding="{Binding AssemblyOrdered, TargetNullValue='—'}" Width="*"/>
                <DataGridTextColumn Header="Компоненты: добавлено" Binding="{Binding ComponentAdded}" Width="*"/>
                <DataGridTextColumn Header="Компоненты: заказано" Binding="{Binding ComponentOrdered, TargetNullValue='—'}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
