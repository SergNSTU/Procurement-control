<UserControl x:Class="ProcurementControl.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов (аналог notesToolbar) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Заметка:"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox Width="260"
                      Height="30"
                      VerticalContentAlignment="Center"
                      FontFamily="Segoe UI"
                      FontSize="12"
                      ItemsSource="{Binding Notes}"
                      SelectedItem="{Binding SelectedNote}"
                      DisplayMemberPath="Name"
                      Margin="0,0,10,0"/>

            <Button Content="Новая заметка"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding NewNoteCommand}"
                    Height="30"
                    Margin="0,0,8,0"/>

            <Button Content="Сохранить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    Height="30"
                    Margin="0,0,8,0"/>

            <Button Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}"
                    Height="30"/>

            <TextBlock Text="{Binding StatusMessage}"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Текущий путь к файлу заметки (аналог notesPathLabel) -->
        <TextBlock Grid.Row="1"
                   Text="{Binding CurrentPath}"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center"/>

        <!-- Редактор заметки (аналог txtProjectNotes) -->
        <TextBox Grid.Row="2"
                 Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Segoe UI"
                 FontSize="14"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="8"
                 Background="{StaticResource SurfaceBrush}"
                 Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource LineBrush}"/>
    </Grid>
</UserControl>
