<UserControl x:Class="ProcurementControl.Views.QuoteBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcurementControl.Views"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- Строка квоты: победители подсвечены (аналог DefaultCellStyle.BackColor = Success) -->
        <Style x:Key="QuoteRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource AppGridRowStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Тулбар: поиск, диапазон дат, обновление, экспорт, режим чтения -->
        <WrapPanel Grid.Row="0" Style="{StaticResource ToolbarWrapStyle}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Поиск:" Margin="0,0,8,0"/>
            <TextBox Width="220" Margin="0,0,12,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="С даты:" Margin="0,0,8,0"/>
            <TextBox Width="110" Margin="0,0,12,0"
                     Text="{Binding DateFromText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="по" Margin="0,0,8,0"/>
            <TextBox Width="110" Margin="0,0,12,0"
                     Text="{Binding DateToText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    Height="30" Margin="0,0,8,0"/>
            <Button Content="Загрузить квоты"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ImportQuotesCommand}"
                    Height="30" Margin="0,0,8,0"/>
            <Button Content="Экспорт Excel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ExportCommand}"
                    Height="30"/>
        </WrapPanel>

        <!-- Вкладки в карточке: наши квоты и Globalist (аналог $quoteBaseTabs) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,8" Margin="0,14,0,0">
            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                <TabItem Header="Наши квоты">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                            <DataGrid x:Name="QuotesGrid"
                                      SelectionChanged="QuotesGrid_SelectionChanged"
                                      ItemsSource="{Binding QuoteRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      RowStyle="{StaticResource QuoteRowStyle}"
                                      BorderThickness="1"
                                      BorderBrush="{StaticResource LineBrush}"
                                      RowHeight="28"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата квоты" Binding="{Binding QuoteDate}" Width="145"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding RfqValue}" Width="260"/>
                                    <DataGridTextColumn Header="PN" Binding="{Binding PN}" Width="180"/>
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding RequestedQuantity}" Width="80"/>
                                    <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="120"/>
                                    <DataGridTextColumn Header="Цена" Binding="{Binding PriceText}" Width="90"/>
                                    <DataGridTextColumn Header="Срок" Binding="{Binding LeadTime}" Width="100"/>
                                    <DataGridTextColumn Header="MFG" Binding="{Binding Mfg}" Width="140"/>
                                    <DataGridTextColumn Header="Побед." Binding="{Binding WinnerMark}" Width="62"/>
                                    <DataGridTextColumn Header="Почему выбран" Binding="{Binding WinnerReason}" Width="170"/>

                                    <!-- Предупреждение: непустое подсвечено (аналог ячейки 'Warning' с Danger) -->
                                    <DataGridTemplateColumn Header="Предупреждение" Width="280" SortMemberPath="Warning">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Warning}" VerticalAlignment="Center" Padding="8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Удалить выбранные"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DeleteSelectedCommand}"
                                    Height="30" Margin="0,0,8,0"/>
                            <Button Content="Очистить всё"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearAllCommand}"
                                    Height="30" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerTextBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Globalist">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Аналог $btnImportGlobalist: полная замена таблицы globalist_quotes -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Импорт Globalist..."
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ImportGlobalistCommand}"
                                    Height="30" MinWidth="160"/>
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                            <DataGrid ItemsSource="{Binding GlobalistRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      BorderThickness="1"
                                      BorderBrush="{StaticResource LineBrush}"
                                      RowHeight="28"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Загружено" Binding="{Binding ImportedAt}" Width="135"/>
                                    <DataGridTextColumn Header="Источник" Binding="{Binding Factory}" Width="95"/>
                                    <DataGridTextColumn Header="PN" Binding="{Binding PN}" Width="180"/>
                                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="240"/>
                                    <DataGridTextColumn Header="PI номер" Binding="{Binding PiNumber}" Width="130"/>
                                    <DataGridTextColumn Header="Замена" Binding="{Binding Replacement}" Width="170"/>
                                    <DataGridTextColumn Header="Кит. примечание" Binding="{Binding ChineseRemark}" Width="180"/>
                                    <DataGridTextColumn Header="Корпус" Binding="{Binding Package}" Width="120"/>
                                    <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="120"/>
                                    <DataGridTextColumn Header="DC" Binding="{Binding Datacode}" Width="100"/>
                                    <DataGridTextColumn Header="MOQ" Binding="{Binding Moq}" Width="90"/>
                                    <DataGridTextColumn Header="Количество" Binding="{Binding Qty}" Width="100"/>
                                    <DataGridTextColumn Header="На складе" Binding="{Binding Stock}" Width="100"/>
                                    <DataGridTextColumn Header="Нужен SPQ" Binding="{Binding NeedSpq}" Width="100"/>
                                    <DataGridTextColumn Header="SPQ" Binding="{Binding Spq}" Width="90"/>
                                    <DataGridTextColumn Header="Цена" Binding="{Binding UnitPriceText}" Width="100"/>
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmountText}" Width="110"/>
                                    <DataGridTextColumn Header="Срок, нед." Binding="{Binding LeadTime}" Width="110"/>
                                    <DataGridTextColumn Header="Вес, г" Binding="{Binding Weight}" Width="90"/>
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="110"/>
                                    <DataGridTextColumn Header="ID квоты" Binding="{Binding SupplierQuoteId}" Width="150"/>
                                    <DataGridTextColumn Header="Лист" Binding="{Binding SheetName}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
