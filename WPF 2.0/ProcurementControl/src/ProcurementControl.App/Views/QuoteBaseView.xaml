<UserControl x:Class="ProcurementControl.Views.QuoteBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- Сетка — как в остальных разделах (аналог Set-GridLook) -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Поле тулбара (поиск и даты) -->
        <Style x:Key="ToolbarBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Строка квоты: победители подсвечены (аналог DefaultCellStyle.BackColor = Success) -->
        <Style x:Key="QuoteRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Тулбар: поиск, диапазон дат, обновление, экспорт, режим чтения -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource ToolbarLabel}" Text="Поиск:" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Style="{StaticResource ToolbarBox}" Margin="0,0,12,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabel}" Text="С даты:" Margin="0,0,8,0"/>
            <TextBox Grid.Column="3" Style="{StaticResource ToolbarBox}" Margin="0,0,12,0"
                     Text="{Binding DateFromText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="4" Style="{StaticResource ToolbarLabel}" Text="по" Margin="0,0,8,0"/>
            <TextBox Grid.Column="5" Style="{StaticResource ToolbarBox}" Margin="0,0,12,0"
                     Text="{Binding DateToText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="6" Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    Height="30" Margin="0,0,8,0"/>
            <Button Grid.Column="7" Content="Экспорт Excel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ExportCommand}"
                    Height="30"/>
        </Grid>

        <!-- Вкладки: наши квоты и Globalist (аналог $quoteBaseTabs) -->
        <TabControl Grid.Row="1" Margin="0,12,0,0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="{StaticResource SurfaceBrush}"
                    FontFamily="Segoe UI" FontSize="12">

            <TabItem Header="Наши квоты" Padding="10,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding QuoteRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource QuoteRowStyle}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              BorderThickness="1"
                              BorderBrush="{StaticResource LineBrush}"
                              Foreground="{StaticResource TextBrush}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}"
                              ColumnHeaderHeight="32"
                              RowHeight="28"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата квоты" Binding="{Binding QuoteDate}" Width="145"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding RfqValue}" Width="260"/>
                            <DataGridTextColumn Header="PN" Binding="{Binding PN}" Width="180"/>
                            <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="120"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding PriceText}" Width="90"/>
                            <DataGridTextColumn Header="Срок" Binding="{Binding LeadTime}" Width="100"/>
                            <DataGridTextColumn Header="MFG" Binding="{Binding Mfg}" Width="140"/>
                            <DataGridTextColumn Header="Побед." Binding="{Binding WinnerMark}" Width="62"/>
                            <DataGridTextColumn Header="Почему выбран" Binding="{Binding WinnerReason}" Width="170"/>

                            <!-- Предупреждение: непустое подсвечено (аналог ячейки 'Warning' с Danger) -->
                            <DataGridTemplateColumn Header="Предупреждение" Width="280" SortMemberPath="Warning">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Warning}" VerticalAlignment="Center" Padding="8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ReadOnlyNotice}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerTextBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Globalist" Padding="10,4">
                <DataGrid ItemsSource="{Binding GlobalistRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          RowBackground="{StaticResource SurfaceBrush}"
                          AlternatingRowBackground="{StaticResource SurfaceAltBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource LineBrush}"
                          BorderThickness="1"
                          BorderBrush="{StaticResource LineBrush}"
                          Foreground="{StaticResource TextBrush}"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          CellStyle="{StaticResource GridCellStyle}"
                          ColumnHeaderHeight="32"
                          RowHeight="28"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Загружено" Binding="{Binding ImportedAt}" Width="135"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding Factory}" Width="95"/>
                        <DataGridTextColumn Header="PN" Binding="{Binding PN}" Width="180"/>
                        <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="240"/>
                        <DataGridTextColumn Header="PI номер" Binding="{Binding PiNumber}" Width="130"/>
                        <DataGridTextColumn Header="Замена" Binding="{Binding Replacement}" Width="170"/>
                        <DataGridTextColumn Header="Кит. примечание" Binding="{Binding ChineseRemark}" Width="180"/>
                        <DataGridTextColumn Header="Корпус" Binding="{Binding Package}" Width="120"/>
                        <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="120"/>
                        <DataGridTextColumn Header="DC" Binding="{Binding Datacode}" Width="100"/>
                        <DataGridTextColumn Header="MOQ" Binding="{Binding Moq}" Width="90"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Qty}" Width="100"/>
                        <DataGridTextColumn Header="На складе" Binding="{Binding Stock}" Width="100"/>
                        <DataGridTextColumn Header="Нужен SPQ" Binding="{Binding NeedSpq}" Width="100"/>
                        <DataGridTextColumn Header="SPQ" Binding="{Binding Spq}" Width="90"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding UnitPriceText}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmountText}" Width="110"/>
                        <DataGridTextColumn Header="Срок, нед." Binding="{Binding LeadTime}" Width="110"/>
                        <DataGridTextColumn Header="Вес, г" Binding="{Binding Weight}" Width="90"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="110"/>
                        <DataGridTextColumn Header="ID квоты" Binding="{Binding SupplierQuoteId}" Width="150"/>
                        <DataGridTextColumn Header="Лист" Binding="{Binding SheetName}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
