<UserControl x:Class="ProcurementControl.Views.BitrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcurementControl.Views"
             Background="{StaticResource CanvasBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Тулбар: переключатель автоимпорта + ручная проверка -->
        <WrapPanel Grid.Row="0" Style="{StaticResource ToolbarWrapStyle}">
            <Button Content="Проверить сейчас"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CheckNowCommand}"
                    Width="150" Height="32" Margin="0,0,12,0"/>
            <CheckBox Content="Автоимпорт сделок из Bitrix (проверка раз в 10 минут)"
                      IsChecked="{Binding AutoImportEnabled}"
                      VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource ToolbarStatusTextStyle}"/>
        </WrapPanel>

        <!-- Импортированные сделки (связь bitrix_task_links + deals) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,10,0,0">
            <Border CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                <DataGrid x:Name="RowsGrid"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          MouseDoubleClick="RowsGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Скопировать номер"
                                      Command="{Binding CopyNumberCommand}"/>
                            <MenuItem Header="Открыть задачу в Bitrix"
                                      Command="{Binding OpenLinkCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Сделка" Binding="{Binding DealNumber}" Width="120"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во плат" Binding="{Binding BoardCount}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Этап" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAtText}" Width="110"/>
                        <DataGridTextColumn Header="ID задачи" Binding="{Binding TaskId}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ссылка" Binding="{Binding LinkText}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,8,0,0"
                   Text="Проект: «Заявка на расчет КС в РФ». Новыми считаются задачи, созданные после первого запуска этой версии приложения; название задачи — «Номер/Клиент/Описание - N шт.»"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
