<UserControl x:Class="ProcurementControl.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcurementControl.Views"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- Плитка метрики (аналог New-CockpitMetricCard) -->
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinWidth" Value="170"/>
        </Style>
        <Style x:Key="TileCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="TileHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- Спокойный фон строки: критичность показывается метками в ячейках,
             а не сплошной тревожной заливкой всей таблицы. -->
        <Style x:Key="DealRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource AppGridRowStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="Archived">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReminderOverdue}" Value="True">
                    <Setter Property="Background" Value="#FFF1F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Редактируемые ячейки явно реагируют на наведение и подсказывают способ ввода. -->
        <Style x:Key="EditableDealCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource AppGridCellStyle}">
            <Setter Property="ToolTip" Value="Двойной щелчок или Enter — изменить и сохранить."/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DoubleClickDealCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource AppGridCellStyle}">
            <Setter Property="ToolTip" Value="Дважды щёлкните, чтобы изменить."/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="320"/>
        </Grid.RowDefinitions>

        <!-- Карточки метрик -->
        <WrapPanel Grid.Row="0">
            <Border Style="{StaticResource MetricTile}" Background="{StaticResource InfoBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileCaption}" Text="Активные сделки"/>
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding ActiveCount}"/>
                    <TextBlock Style="{StaticResource TileHint}" Text="Активные, отслеживание, Китай и задачи"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricTile}" Background="{StaticResource DangerBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileCaption}" Text="Просрочено"/>
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding OverdueCount}"/>
                    <TextBlock Style="{StaticResource TileHint}" Text="Нужна реакция"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricTile}" Background="{StaticResource WarnBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileCaption}" Text="Задачи в работе"/>
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding WorkAndPaymentTaskCount}"/>
                    <TextBlock Style="{StaticResource TileHint}" Text="В работе и подано в оплату"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricTile}" Background="{StaticResource AttentionBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileCaption}" Text="Требуют внимания"/>
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding AttentionCount}"/>
                    <TextBlock Style="{StaticResource TileHint}" Text="Нужна ручная проверка"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricTile}" Background="{StaticResource SurfaceAltBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileCaption}" Text="Количество напоминаний"/>
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding ReminderCount}"/>
                    <TextBlock Style="{StaticResource TileHint}" Text="Активные напоминания"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Тулбар: поиск, фильтр и главное действие; остальные команды в меню. -->
        <WrapPanel Grid.Row="1" Style="{StaticResource ToolbarWrapStyle}" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Поиск:" Margin="0,0,8,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Фильтр:" Margin="12,0,8,0"/>
            <ComboBox ItemsSource="{Binding Filters}"
                      SelectedItem="{Binding SelectedFilter}"
                      Width="180"/>
            <Button Content="Новая сделка"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding NewDealCommand}"
                    Height="30" Margin="12,0,4,0"/>
            <Button Content="⋯" Style="{StaticResource SecondaryButtonStyle}" Width="36" Height="30"
                    Background="Transparent" BorderBrush="Transparent" Padding="0" FontSize="17"
                    ToolTip="Дополнительные действия" Click="PurchaseActionsButton_Click">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Добавить поставщика" Command="{Binding AddSupplierCommand}"/>
                        <MenuItem Header="Изменить поставщика" Command="{Binding EditSupplierCommand}"/>
                        <MenuItem Header="Удалить поставщика" Command="{Binding DeleteSupplierCommand}"/>
                        <Separator/>
                        <MenuItem Header="{Binding ArchiveButtonText}" Command="{Binding ToggleArchiveCommand}"/>
                        <MenuItem Header="Удалить сделку" Command="{Binding DeleteDealCommand}"/>
                        <Separator/>
                        <MenuItem Header="Обновить список" Command="{Binding ReloadCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>

        <!-- Сетка сделок в карточке -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,14,0,0">
            <Border CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                <DataGrid x:Name="DealsGrid" ItemsSource="{Binding Deals}"
                          SelectedItem="{Binding SelectedDeal, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowStyle="{StaticResource DealRowStyle}"
                          BorderThickness="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Loaded="DealsGrid_Loaded"
                          PreviewMouseLeftButtonDown="DealsGrid_PreviewMouseLeftButtonDown"
                          MouseDoubleClick="DealsGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="DealsGrid_PreviewMouseRightButtonDown"
                          BeginningEdit="DealsGrid_BeginningEdit"
                          CellEditEnding="DealsGrid_CellEditEnding">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Скопировать номер" Command="{Binding CopyDealNumberCommand}"/>
                            <MenuItem Header="В архив / вернуть" Command="{Binding ToggleArchiveCommand}"/>
                            <Separator/>
                            <MenuItem Header="Удалить сделку" Command="{Binding DeleteDealCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Сделка" Binding="{Binding DealNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="DealNumber" Width="190" CellStyle="{StaticResource EditableDealCellStyle}"/>
                        <DataGridTextColumn Header="Кол-во плат" Binding="{Binding BoardCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="BoardCount" Width="92" CellStyle="{StaticResource EditableDealCellStyle}"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Client, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Client" Width="150" CellStyle="{StaticResource EditableDealCellStyle}"/>

                        <DataGridTemplateColumn Header="Этап" Width="104" SortMemberPath="Status" CellStyle="{StaticResource EditableDealCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="8" HorizontalAlignment="Left" Background="{StaticResource InfoBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="RRFQ"><Setter Property="Background" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="PI"><Setter Property="Background" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Заказано"><Setter Property="Background" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="В работе"><Setter Property="Background" Value="{StaticResource AttentionBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DealStatuses, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Приоритет остаётся заметной меткой, не заливая всю строку. -->
                        <DataGridTemplateColumn Header="Приоритет" Width="92" SortMemberPath="Priority" CellStyle="{StaticResource EditableDealCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="8" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Priority3Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Срочно"><Setter Property="Background" Value="{StaticResource PriorityUrgentBrush}"/><Setter Property="TextElement.Foreground" Value="White"/><Setter Property="TextElement.FontWeight" Value="Bold"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="1"><Setter Property="Background" Value="{StaticResource Priority1Brush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="2"><Setter Property="Background" Value="{StaticResource Priority2Brush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="3"><Setter Property="Background" Value="{StaticResource Priority3Brush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="4"><Setter Property="Background" Value="{StaticResource Priority4Brush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="5"><Setter Property="Background" Value="{StaticResource Priority5Brush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Priority}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate><ComboBox ItemsSource="{Binding DataContext.DealPriorities, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Напоминание: просроченное выделяется красным -->
                        <DataGridTemplateColumn Header="Напоминание" Width="112" SortMemberPath="ReminderDateText" CellStyle="{StaticResource DoubleClickDealCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="8" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReminderOverdue}" Value="True">
                                                        <Setter Property="Background" Value="#FF0000"/>
                                                        <Setter Property="TextElement.Foreground" Value="White"/>
                                                        <Setter Property="TextElement.FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ReminderDateText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Поставщики" Binding="{Binding SupplierCount}" Width="92" IsReadOnly="True"/>
                        <DataGridTextColumn Header="PI" Binding="{Binding InvoiceCount}" Width="58" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Оплачено" Binding="{Binding PaymentText}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Готово" Binding="{Binding DoneText}" Width="74" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Маски" Width="82" SortMemberPath="MasksText" CellStyle="{StaticResource EditableDealCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding MasksText}" Padding="8,0"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DealMasks, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding MasksText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Отслеживание" Binding="{Binding TrackingStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="TrackingStatus" Width="120" CellStyle="{StaticResource EditableDealCellStyle}"/>
                        <DataGridTextColumn Header="Комментарий" SortMemberPath="Comment" Width="130"
                                            Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CellStyle="{StaticResource EditableDealCellStyle}"/>
                        <DataGridTemplateColumn Header="Поступление комплектации" Width="180" SortMemberPath="CompletionReceiptDate" IsReadOnly="True" CellStyle="{StaticResource DoubleClickDealCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CompletionReceiptText}" Padding="8,0"
                                               ToolTip="Дважды щёлкните, чтобы изменить даты поступления поставщиков."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Обновлено" Binding="{Binding UpdatedAt}" Width="142" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Период" Width="110" SortMemberPath="Period" CellStyle="{StaticResource EditableDealCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Period}" Padding="8,0"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              ItemsSource="{Binding DataContext.DealPeriods, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              Text="{Binding Period, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Исполнитель" Width="110" SortMemberPath="Executor" CellStyle="{StaticResource EditableDealCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Executor}" Padding="8,0"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate><ComboBox ItemsSource="{Binding DataContext.DealExecutors, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Executor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Место сборки" Width="120" SortMemberPath="AssemblyLocation" CellStyle="{StaticResource EditableDealCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding AssemblyLocation}" Padding="8,0"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate><ComboBox ItemsSource="{Binding DataContext.AssemblyLocations, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding AssemblyLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Карточка сделки + поставщики -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Компактная карточка: остальные реквизиты редактируются в строке таблицы. -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,4,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Этап:"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DealStatuses}" SelectedItem="{Binding EditStatus}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Приоритет:"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding DealPriorities}" SelectedItem="{Binding EditPriority}"/>
                    <TextBlock Grid.Column="6" Style="{StaticResource FieldLabel}" Text="Напоминание:"/>
                    <DockPanel Grid.Column="7">
                        <Button Content="…" Width="30" DockPanel.Dock="Right" Margin="6,0,0,0" Click="PickDealReminderDateClick"/>
                        <TextBox Text="{Binding EditReminderDate, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Grid.Column="9" Style="{StaticResource FieldLabel}" Text="Комментарий:"/>
                    <TextBox Grid.Column="10" MinWidth="180" Text="{Binding EditComment, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="12" Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveDealCommand}" Height="30"/>
                </Grid>
            </Border>

            <!-- Поставщики и документы выбранной сделки -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Поставщики выбранной сделки в карточке -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <Border CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                        <DataGrid x:Name="SuppliersGrid" ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  FrozenColumnCount="1"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  BorderThickness="0"
                                  RowHeight="28"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  MouseDoubleClick="SuppliersGrid_MouseDoubleClick"
                                  CellEditEnding="SuppliersGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Сумма PI $" Binding="{Binding PiAmountUsd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="PiAmountUsd" Width="92"/>
                                <DataGridTextColumn Header="Сумма PI ¥" Binding="{Binding PiAmountCny, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="PiAmountCny" Width="92"/>
                                <DataGridTextColumn Header="Сумма RUB" Binding="{Binding PiAmountRub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="PiAmountRub" Width="92"/>
                                <DataGridTextColumn Header="Оплачено" Binding="{Binding PaidAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="PaidAmount" Width="92"/>
                                <DataGridTextColumn Header="Срок" Binding="{Binding DeliveryWeeks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="DeliveryWeeks" Width="58"/>
                                <DataGridCheckBoxColumn Header="Подано в оплату" Binding="{Binding PaymentSubmitted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridCheckBoxColumn Header="Оплачено?" Binding="{Binding Paid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="76"/>
                                <DataGridCheckBoxColumn Header="Инвойс" Binding="{Binding InvoiceReceived, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                                <DataGridCheckBoxColumn Header="Инвойс подтв." Binding="{Binding InvoiceConfirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="98"/>
                                <DataGridCheckBoxColumn Header="ERP пост." Binding="{Binding ErpSupplierSent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="76"/>
                                <DataGridCheckBoxColumn Header="ERP Roger" Binding="{Binding ErpRogerSent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="Дата подтв." Binding="{Binding InvoiceConfirmedDate}" SortMemberPath="InvoiceConfirmedDate" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="План поступл." Binding="{Binding ComponentsReceiptDate}" SortMemberPath="ComponentsReceiptDate" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Факт поступл." Binding="{Binding ActualReceiptDate}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="220" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Border>

                <!-- Документы сделки: перенос панели $docsGrid (RRFQComparer.ps1, 2161-2225) -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" Margin="12,0,0,0">
                    <Border CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="12,8,12,6">
                                <Button Content="Выбрать файлы"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PickDocumentsCommand}"
                                        Height="26" DockPanel.Dock="Right"/>
                                <Button Content="Загрузить квоты"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding LoadQuotesFromDocumentCommand}"
                                        Height="26" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                                <TextBlock Text="Документы сделки: перетащите или выберите файлы"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DockPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Documents}"
                                      SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      BorderThickness="0"
                                      RowHeight="28"
                                      AllowDrop="True"
                                      Drop="DocumentsDrop"
                                      PreviewDragOver="DocumentsDragOver"
                                      MouseDoubleClick="DocumentsGrid_MouseDoubleClick"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Открыть в проводнике" Command="{Binding OpenDocumentInExplorerCommand}"/>
                                        <MenuItem Header="Загрузить квоты" Command="{Binding LoadQuotesFromDocumentCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Удалить" Command="{Binding DeleteDocumentCommand}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding DocumentType}" Width="110"/>
                                    <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="120"/>
                                    <DataGridTextColumn Header="Файл" Binding="{Binding OriginalName}" Width="260"/>
                                    <DataGridTextColumn Header="Загружен" Binding="{Binding UploadedAt}" Width="140"/>
                                    <DataGridTextColumn Header="Путь" Binding="{Binding StoredPath}" Width="360"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Grid>
