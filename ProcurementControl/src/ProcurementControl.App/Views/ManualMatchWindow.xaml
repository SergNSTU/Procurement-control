<Window x:Class="ProcurementControl.Views.ManualMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ручное сопоставление"
        Width="1220" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <!-- Стили сеток — копии из разметки раздела (аналог Set-GridLook) -->
        <Style x:Key="GridLook" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="RowHeight" Value="28"/>
        </Style>

        <Style x:Key="GridHeaderLook" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,6,4,4"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBorderBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Подсказка поиска (аналог Set-TextBoxPlaceholder): видна, пока поле пустое -->
        <Style x:Key="SearchHint" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,6,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="580"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Слева: несопоставленные квоты -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBox x:Name="quoteSearchBox" Style="{StaticResource SearchBox}"
                         Text="{Binding QuoteSearch, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Поиск по несопоставленным квотам">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SearchHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=quoteSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <DataGrid Grid.Row="1" Style="{StaticResource GridLook}"
                      ColumnHeaderStyle="{StaticResource GridHeaderLook}"
                      ItemsSource="{Binding UnmatchedQuotes}"
                      SelectedItem="{Binding SelectedQuote, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Поставщик" Width="110" Binding="{Binding Supplier}"/>
                    <DataGridTextColumn Header="Файл" Width="150" Binding="{Binding FileName}"/>
                    <DataGridTextColumn Header="Лист" Width="80" Binding="{Binding SheetName}"/>
                    <DataGridTextColumn Header="Строка" Width="56" Binding="{Binding Row}"/>
                    <DataGridTextColumn Header="Ключ" Width="*" Binding="{Binding Key}"/>
                    <DataGridTextColumn Header="Статус" Width="90" Binding="{Binding MatchStatus}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Справа: строки RFQ и кнопки -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBox x:Name="rfqSearchBox" Style="{StaticResource SearchBox}"
                         Text="{Binding RfqSearch, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Поиск по строкам RFQ">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SearchHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=rfqSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <DataGrid Grid.Row="1" Style="{StaticResource GridLook}"
                      ColumnHeaderStyle="{StaticResource GridHeaderLook}"
                      ItemsSource="{Binding RfqRows}"
                      SelectedItem="{Binding SelectedRfqRow, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Лист" Width="110" Binding="{Binding SheetName}"/>
                    <DataGridTextColumn Header="Строка" Width="60" Binding="{Binding Row}"/>
                    <DataGridTextColumn Header="RFQ позиция" Width="*" Binding="{Binding Key}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Сопоставить выбранные" Width="180" Height="30" Margin="8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding MatchCommand}"/>
                <Button Content="Закрыть" Width="120" Height="30"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
