<Window x:Class="ProcurementControl.Views.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0"
                   Foreground="{StaticResource TextBrush}"
                   FontFamily="Segoe UI" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBox x:Name="InputBox" Grid.Row="1" MinHeight="38"
                 FontFamily="Segoe UI" FontSize="12"
                 VerticalContentAlignment="Center"
                 Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource LineBrush}"
                 Foreground="{StaticResource TextBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="ОК"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="90" Height="30" Margin="0,0,8,0"
                    Click="AcceptClick" IsDefault="True"/>
            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="90" Height="30"
                    Click="CancelClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
