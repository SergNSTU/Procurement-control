<Window x:Class="ProcurementControl.Views.ManualQuoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ручной ввод квоты"
        Width="560" Height="520" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <!-- Поле ввода диалога (аналог Add-ManualQuoteTextBox) -->
        <Style x:Key="DialogBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBorderBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- Поставщик: редактируемый комбобокс из конфига -->
        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Поставщик"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                  IsEditable="True"
                  ItemsSource="{Binding SupplierNames}"
                  Text="{Binding SupplierText, UpdateSourceTrigger=PropertyChanged}"
                  Background="{StaticResource SurfaceBrush}"
                  Foreground="{StaticResource TextBrush}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Цена Unit price"/>
        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Lead Time"/>
        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding LeadTime, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="PN"/>
        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding PN, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="D/C"/>
        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding DC, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="MFG from Russia"/>
        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding MfgRussia, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="MFG from China"/>
        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding MfgChina, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Q-ty in packing"/>
        <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding QtyPacking, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Q-ty to Buy/pcs"/>
        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding QtyToBuy, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="China remark"/>
        <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource DialogBox}"
                 Text="{Binding ChinaRemark, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Инфо-бокс (аналог $info) -->
        <TextBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6"
                 Text="{Binding InfoText, Mode=OneWay}"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource SurfaceAltBrush}"
                 Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource LineBrush}"
                 Padding="6"/>

        <!-- Кнопки справа-налево: Сохранить у правого края (оригинал) -->
        <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Отмена" Width="100" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"/>
            <Button Content="Сохранить" Width="120" Height="30"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
