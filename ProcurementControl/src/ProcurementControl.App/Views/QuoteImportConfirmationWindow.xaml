<Window x:Class="ProcurementControl.Views.QuoteImportConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт квот" Width="900" Height="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Импортировать" Style="{StaticResource PrimaryButtonStyle}" Width="130" Height="30" Margin="0,0,8,0" Click="AcceptClick" IsDefault="True"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="30" Click="CancelClick" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="SummaryText" Grid.Row="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Quotes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="150"/>
                    <DataGridTextColumn Header="PN" Binding="{Binding PN}" Width="170"/>
                    <DataGridTextColumn Header="Значение" Binding="{Binding Key}" Width="170"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice}" Width="90"/>
                    <DataGridTextColumn Header="Валюта" Binding="{Binding Currency}" Width="75"/>
                    <DataGridTextColumn Header="Срок" Binding="{Binding LeadTime}" Width="110"/>
                    <DataGridTextColumn Header="Предупреждение" Binding="{Binding Warning}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
