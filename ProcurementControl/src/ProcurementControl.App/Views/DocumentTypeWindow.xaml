<Window x:Class="ProcurementControl.Views.DocumentTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тип документа"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="360"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Выберите тип для загружаемых файлов"
                   Foreground="{StaticResource TextBrush}"
                   FontFamily="Segoe UI" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ComboBox x:Name="TypeCombo" Grid.Row="1" Height="30"
                  FontFamily="Segoe UI" FontSize="12"
                  VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="90" Height="30" Margin="0,0,8,0"
                    Click="AcceptClick" IsDefault="True"/>
            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="90" Height="30"
                    Click="CancelClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
