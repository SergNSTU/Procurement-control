<UserControl x:Class="ProcurementControl.Views.ExcelCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">

    <!-- Перенос $excelCompareLayout: заголовок, два пути, кнопки — в карточке -->
    <Border Style="{StaticResource CardStyle}" Margin="18" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Сравнение Excel" Margin="0,0,0,12"/>

            <TextBox Margin="0,0,0,8"
                     Text="{Binding File1Text, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="0,0,0,12"
                     Text="{Binding File2Text, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Выбрать первый файл"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding PickFile1Command}"
                        Width="170" Height="32" Margin="0,0,8,0"/>
                <Button Content="Выбрать второй файл"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding PickFile2Command}"
                        Width="170" Height="32" Margin="0,0,8,0"/>
                <Button Content="Сравнить и сохранить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CompareCommand}"
                        Width="190" Height="32"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerTextBrush}" FontSize="12"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
