<Window x:Class="ProcurementControl.Views.RrfqMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свести RRFQ" WindowStartupLocation="CenterOwner" Width="720" Height="480"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Выберите исходный RFQ и ответы поставщиков для одного сравнения. Сводные RRFQ здесь не показываются." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="RfqCombo" Grid.Row="1" Margin="0,10,0,10" Height="30" DisplayMemberPath="OriginalName"/>
        <DataGrid x:Name="ResponsesGrid" Grid.Row="2" ItemsSource="{Binding}" AutoGenerateColumns="False" SelectionMode="Extended" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierDisplay}" Width="180"/>
                <DataGridTextColumn Header="Файл RRFQ" Binding="{Binding OriginalName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Передать в сравнение" Style="{StaticResource PrimaryButtonStyle}" Width="170" Height="30" Margin="0,0,8,0" Click="AcceptClick" IsDefault="True"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="30" Click="CancelClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
