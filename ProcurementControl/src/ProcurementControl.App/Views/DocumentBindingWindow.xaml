<Window x:Class="ProcurementControl.Views.DocumentBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тип и поставщик документа" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height" Width="450"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Изменение не загружает файл повторно и не меняет его путь." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
        <ComboBox x:Name="TypeCombo" Grid.Row="1" Height="30" DisplayMemberPath="."/>
        <ComboBox x:Name="SupplierCombo" Grid.Row="2" Height="30" Margin="0,8,0,0" DisplayMemberPath="Supplier"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="30" Margin="0,0,8,0" Click="AcceptClick" IsDefault="True"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="30" Click="CancelClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
