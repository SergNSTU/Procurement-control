<UserControl x:Class="ProcurementControl.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="NoteListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Заметки" Margin="4,2,4,10"/>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NoteListItemStyle}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource ToolbarStatusTextStyle}"
                           Margin="4,10,4,2" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NoteTitle}" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel Grid.Column="1">
                            <Button Content="Новая" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding NewNoteCommand}" Height="30" Margin="0,0,6,0"/>
                            <Button Content="Переименовать" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RenameNoteCommand}" Height="30" Margin="0,0,6,0"/>
                            <Button Content="Удалить" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DeleteNoteCommand}" Height="30" Margin="0,0,6,0"/>
                            <Button Content="Обновить" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ReloadCommand}" Height="30"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <TextBox Grid.Row="1"
                         Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         FontFamily="Segoe UI"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalContentAlignment="Top"
                          BorderThickness="0"
                         Background="Transparent"
                         Padding="16"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
