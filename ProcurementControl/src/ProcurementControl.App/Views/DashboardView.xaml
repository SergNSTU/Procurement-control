<UserControl x:Class="ProcurementControl.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcurementControl.Views"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- Плитка метрики (аналог New-CockpitMetricCard) -->
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="TileCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: выбранный период, фильтры, дата старта отслеживания и обновление -->
        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding PeriodLabel}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Text="Год" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                      Width="84" Height="30" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding PeriodModes}" SelectedItem="{Binding SelectedPeriodModeOption, Mode=TwoWay}"
                      Width="102" Height="30" Margin="0,0,10,0">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                      Width="126" Height="30" Margin="0,0,16,0">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Margin="0,0,16,0">
                <Run Text="Отслеживание заказов с:"/>
                <Run Text="{Binding TrackingStartedText, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}"
                    Height="30"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerTextBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </WrapPanel>

        <!-- Карточки метрик -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Сборки -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Сборки" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource InfoBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}"><Run Text="Добавлено за "/><Run Text="{Binding PeriodUnitLabel}"/></TextBlock>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesAdded}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource InfoBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}"><Run Text="Заказано за "/><Run Text="{Binding PeriodUnitLabel}"/></TextBlock>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesOrdered}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource InfoBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}" Text="Сумма заказов, $"/>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesOrderAmount}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource SuccessBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}" Text="Конверсия (тек. когорта)"/>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesCurrentConversion}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource SuccessBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}" Text="Зрелая конверсия"/>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding AssembliesMatureConversion}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Компоненты -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Компоненты" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource WarnBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}"><Run Text="Добавлено за "/><Run Text="{Binding PeriodUnitLabel}"/></TextBlock>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsAdded}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource WarnBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}"><Run Text="Заказано за "/><Run Text="{Binding PeriodUnitLabel}"/></TextBlock>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsOrdered}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource WarnBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}" Text="Сумма заказов, $"/>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsOrderAmount}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource SuccessBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}" Text="Конверсия (тек. когорта)"/>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsCurrentConversion}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Background="{StaticResource SuccessBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileCaption}" Text="Зрелая конверсия"/>
                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding ComponentsMatureConversion}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- История за 6 месяцев -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,14,0,0">
            <!-- Обрезка по скруглению карточки (чтобы углы таблицы не выпирали) -->
            <Border CornerRadius="10" Background="Transparent" local:RoundedClip.Radius="10">
                <DataGrid BorderThickness="0"
                          ItemsSource="{Binding History}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Месяц" Binding="{Binding Label}" Width="90"/>
                        <DataGridTextColumn Header="Сборки: добавлено" Binding="{Binding AssemblyAdded}" Width="*"/>
                        <DataGridTextColumn Header="Сборки: заказано" Binding="{Binding AssemblyOrdered, TargetNullValue='—'}" Width="*"/>
                        <DataGridTextColumn Header="Компоненты: добавлено" Binding="{Binding ComponentAdded}" Width="*"/>
                        <DataGridTextColumn Header="Компоненты: заказано" Binding="{Binding ComponentOrdered, TargetNullValue='—'}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </Grid>
</UserControl>
