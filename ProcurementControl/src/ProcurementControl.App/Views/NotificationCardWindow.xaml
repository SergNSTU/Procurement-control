<Window x:Class="ProcurementControl.Views.NotificationCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True"
        FontFamily="Segoe UI" FontSize="12">

    <!-- Аналог карточки из Show-NextNotification (RRFQComparer.ps1, строки 827-961) -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка: иконка календаря, заголовок, крестик -->
            <Grid Grid.Row="0">
                <Border Width="54" Height="54"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="20,18,0,0"
                        Background="#EFF6FF" CornerRadius="10">
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                               FontSize="26"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Напоминание"
                           Margin="92,21,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           FontFamily="Segoe UI Semibold" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <Button Content="×"
                        Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,15,18,0"
                        FontSize="14" Foreground="{StaticResource MutedBrush}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseClicked"/>
                <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource LineBrush}"
                           VerticalAlignment="Bottom" Margin="20,0,20,0"/>
            </Grid>

            <!-- Название -->
            <TextBlock Grid.Row="1" x:Name="BodyText"
                       Margin="92,12,28,0"
                       FontFamily="Segoe UI Semibold" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Детали задачи (только для источника component) -->
            <StackPanel Grid.Row="2" x:Name="TaskDetails" Margin="92,6,28,0">
                <TextBlock x:Name="DescriptionText"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NextActionText"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Строка срока -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        Margin="92,10,0,0" VerticalAlignment="Top">
                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Срок:" Margin="8,0,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="DueValue" Margin="10,0,0,0"
                           FontFamily="Segoe UI Semibold" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Кнопки: Открыть / Напомнить позже / Выполнено -->
            <Grid Grid.Row="4" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Открыть"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="30" Click="OpenClicked"/>
                <Button Grid.Column="2" Content="Напомнить позже"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="30" Click="LaterClicked"/>
                <Button Grid.Column="4" Content="Выполнено"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="30" Click="DoneClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
