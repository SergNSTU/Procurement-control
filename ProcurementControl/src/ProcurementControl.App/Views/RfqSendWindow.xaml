<Window x:Class="ProcurementControl.Views.RfqSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Разослать RFQ поставщикам" Width="860" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="AttachmentText" Margin="0,6,0,0"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,10,0,0">
            <DataGrid x:Name="SuppliersGrid"
                      ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="0"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Черновик" Binding="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="280"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Текст письма ({Deal}, {Client}, {Supplier} подставляются автоматически)"
                       Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <TextBox x:Name="BodyBox" MinHeight="140" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     FontFamily="Segoe UI" FontSize="12"
                     Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource LineBrush}"
                     Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SendButton" Content="Создать черновики"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="32" Width="160" Margin="0,0,8,0" Click="SendClick"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}"
                    Height="32" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
