<Window x:Class="ProcurementControl.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="#0F172A">

    <!-- Аналог Show-Toast из UiFoundation.ps1 (строки 179-218) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Rectangle x:Name="KindBar" Grid.Column="0" Fill="#60A5FA"/>

        <TextBlock x:Name="ToastText" Grid.Column="1"
                   Foreground="White"
                   FontFamily="Segoe UI" FontSize="12"
                   MaxWidth="460"
                   TextWrapping="Wrap"
                   Margin="16,12,20,12"/>
    </Grid>
</Window>
